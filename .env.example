# Copy to .env and fill in. `docker compose up -d` starts the database below.
DATABASE_URL="postgresql://instantpainel:instantpainel@localhost:5433/instantpainel"

PORT=3333
# Public URL of this API (used to build upload URLs)
PUBLIC_URL="http://localhost:3333"
# Painel (Next.js) and the public links frontend: CORS + redirect targets
APP_URL="http://localhost:3000"
LINKS_URL="http://localhost:3001"

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# First admin, created by `npm run seed`
ADMIN_EMAIL=""
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""

UPLOAD_DIR="./uploads"
